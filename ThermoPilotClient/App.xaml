<Application x:Class="ThermoPilotClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        注意：不要把 <local:Bootstrapper /> 放在 Application.Resources 里。
        .NET Core 3.0 起 WPF 对 App.xaml 的资源字典采用延迟实例化，
        放在这里的对象不会被构造，Bootstrapper 的 Initialize() 也就不会执行，
        结果就是进程活着但没有任何窗口。
        Bootstrapper 改为在 App 的构造函数中显式创建，见 App.xaml.cs。
    -->

</Application>
