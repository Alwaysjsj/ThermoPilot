<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI;component/Theme/MainColor.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!-- TextBox 通用样式 -->
    <Style x:Key="CommonTextBoxStyle"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="TextBox">

        <Setter Property="VerticalContentAlignment"
                Value="Center" />

        <Setter Property="BorderBrush"
                Value="{StaticResource FirstForeColor}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="Padding"
                Value="1" />

        <Setter Property="TextAlignment"
                Value="Center" />


        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True"
                            CornerRadius="5">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="1"
                                      Background="{StaticResource AreaBackColor}" />

                    </Border>


                    <ControlTemplate.Triggers>

                        <!-- 禁用 -->
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="PART_ContentHost"
                                    Property="Background"
                                    Value="{StaticResource DisabledColor}" />
                        </Trigger>

                        <!-- 正常 -->
                        <Trigger Property="IsEnabled"
                                 Value="True">
                            <Setter TargetName="PART_ContentHost"
                                    Property="Background"
                                    Value="{StaticResource AreaBackColor}" />
                        </Trigger>

                        <!-- 鼠标悬停 -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource MouseOverColor}" />
                        </Trigger>

                        <!-- 获得焦点 -->
                        <Trigger Property="IsFocused"
                                 Value="True">
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource SelectedColor}" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>


    <!-- 默认 TextBox -->
    <Style TargetType="TextBox"
           BasedOn="{StaticResource ResourceKey=CommonTextBoxStyle}" />

</ResourceDictionary>